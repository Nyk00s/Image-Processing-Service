# api service 

IMAGE_API_PORT=8000
IMAGE_API_HOST=0.0.0.0
IMAGE_API_CONTAINER_NAME=image-api

UPLOAD_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=3600

MAX_UPLOAD_SIZE_MB=1000

APP_ENV=dev
LOG_LEVEL=DEBUG

# JWT

JWT_SECRET=####
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# db 

DB_CONTAINER_NAME=postgres
DB_PORT=5432
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_USER=myuser
POSTGRES_DB=mydb
# postgresql+psycopg://user:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://myuser:mysecretpassword@db:5432/mydb

# cache

CACHE_CONTAINER_NAME=redis
CACHE_PORT=6379
REDIS_CACHE_URL=redis://cache:6379/1
REDIS_BROKER_URL=redis://cache:6379/0
CACHE_HOST=cache

# storage

PRESIGNED_URL_TTL_SECONDS=900
STORAGE_CONTAINER_NAME=minio
STORAGE_PORT=9000
CONSOLE_STORAGE_PORT=9001
S3_ENDPOINT_URL=http://storage:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=######
S3_BUCKET=images
S3_REGION=eu-central-1
